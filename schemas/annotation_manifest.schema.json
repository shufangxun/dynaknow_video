{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DynaKnow-Video v1 Knowledge Annotation Manifest Row",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "video_id",
    "domain",
    "subdomain",
    "visible_dynamic_phenomenon",
    "temporal_evidence",
    "candidate_mechanisms",
    "knowledge_point",
    "canonical_knowledge_point",
    "question",
    "choices",
    "answer",
    "dynamic_evidence",
    "static_insufficient_reason",
    "risk_tags",
    "review_status"
  ],
  "properties": {
    "video_id": {"type": "string", "pattern": "^dynaknow_[0-9]{6}$"},
    "domain": {"type": "string", "minLength": 1},
    "subdomain": {"type": "string", "minLength": 1},
    "visible_dynamic_phenomenon": {"type": "string", "minLength": 1},
    "temporal_evidence": {"type": "string", "minLength": 1},
    "candidate_mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "knowledge_point": {"type": "string", "minLength": 10},
    "canonical_knowledge_point": {"type": "string", "minLength": 10},
    "source_grounding_note": {"type": "string"},
    "question": {
      "type": "string",
      "const": "Which knowledge point is best demonstrated by the dynamic process in the video?"
    },
    "choices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C", "D"],
      "properties": {
        "A": {"type": "string", "minLength": 5},
        "B": {"type": "string", "minLength": 5},
        "C": {"type": "string", "minLength": 5},
        "D": {"type": "string", "minLength": 5}
      }
    },
    "answer": {"type": "string", "enum": ["A", "B", "C", "D"]},
    "dynamic_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start_sec", "end_sec", "description"],
        "properties": {
          "start_sec": {"type": "number", "minimum": 0},
          "end_sec": {"type": "number", "exclusiveMinimum": 0},
          "description": {"type": "string", "minLength": 10}
        }
      }
    },
    "static_insufficient_reason": {"type": "string", "minLength": 10},
    "risk_tags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "review_status": {
      "type": "string",
      "enum": ["clean_candidate", "review_candidate", "review_risk", "reject", "diagnostic_animation"]
    }
  }
}
