{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DynaKnow-Video v1 Source-Hidden Evaluation Sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "video_id",
    "split",
    "domain",
    "subdomain",
    "knowledge_point",
    "local_media",
    "duration_sec",
    "question",
    "choices",
    "answer",
    "dynamic_evidence",
    "static_insufficient_reason",
    "shortcut_labels"
  ],
  "properties": {
    "video_id": {"type": "string", "pattern": "^dynaknow_[0-9]{6}$"},
    "split": {"type": "string", "minLength": 1},
    "domain": {
      "type": "string",
      "enum": [
        "physics_physical_systems",
        "chemistry_materials_change",
        "biology_living_systems",
        "earth_environmental_systems",
        "engineering_operational_systems"
      ]
    },
    "subdomain": {"type": "string", "minLength": 1},
    "knowledge_point": {"type": "string", "minLength": 10},
    "local_media": {"type": "string", "minLength": 1},
    "duration_sec": {"type": "number", "exclusiveMinimum": 0},
    "question": {
      "type": "string",
      "const": "Which knowledge point is best demonstrated by the dynamic process in the video?"
    },
    "choices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C", "D"],
      "properties": {
        "A": {"type": "string", "minLength": 5},
        "B": {"type": "string", "minLength": 5},
        "C": {"type": "string", "minLength": 5},
        "D": {"type": "string", "minLength": 5}
      }
    },
    "answer": {"type": "string", "enum": ["A", "B", "C", "D"]},
    "dynamic_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_sec", "end_sec", "description"],
        "properties": {
          "start_sec": {"type": "number", "minimum": 0},
          "end_sec": {"type": "number", "exclusiveMinimum": 0},
          "description": {"type": "string", "minLength": 10}
        }
      }
    },
    "static_insufficient_reason": {"type": "string", "minLength": 10},
    "shortcut_labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_only_leakage",
        "single_frame_sufficient",
        "sparse_frames_sufficient",
        "dynamic_knowledge_supported",
        "ocr_leakage_status"
      ],
      "properties": {
        "answer_only_leakage": {"type": "string", "enum": ["low", "medium", "high", "pass", "fail", "not_run", ""]},
        "single_frame_sufficient": {"type": "string", "enum": ["yes", "no", "uncertain", "pass", "fail", "not_run", ""]},
        "sparse_frames_sufficient": {"type": "string", "enum": ["yes", "no", "uncertain", "pass", "fail", "not_run", ""]},
        "dynamic_knowledge_supported": {"type": "string", "enum": ["yes", "no", "uncertain", "pass", "fail", "not_run", ""]},
        "ocr_leakage_status": {"type": "string", "enum": ["pass", "fail", "target_text_present", "not_run", ""]}
      }
    }
  }
}
