{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DynaKnow-Video v1 Sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "video_id",
    "source_url",
    "license_or_usage_note",
    "duration_sec",
    "category",
    "knowledge_point",
    "question",
    "choices",
    "answer",
    "dynamic_evidence",
    "static_insufficient_reason",
    "shortcut_results",
    "review"
  ],
  "properties": {
    "video_id": {"type": "string", "pattern": "^dynaknow_[0-9]{6}$"},
    "source_url": {"type": "string", "minLength": 1},
    "license_or_usage_note": {"type": "string", "minLength": 1},
    "duration_sec": {"type": "number", "exclusiveMinimum": 0},
    "category": {
      "type": "string",
      "enum": [
        "physics_mechanics",
        "chemistry_material_change",
        "biology_life_processes",
        "everyday_causal_mechanisms",
        "procedural_operational_principles"
      ]
    },
    "knowledge_point": {"type": "string", "minLength": 10},
    "question": {"type": "string", "minLength": 10},
    "choices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C", "D"],
      "properties": {
        "A": {"type": "string", "minLength": 5},
        "B": {"type": "string", "minLength": 5},
        "C": {"type": "string", "minLength": 5},
        "D": {"type": "string", "minLength": 5}
      }
    },
    "answer": {"type": "string", "enum": ["A", "B", "C", "D"]},
    "dynamic_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_sec", "end_sec", "description"],
        "properties": {
          "start_sec": {"type": "number", "minimum": 0},
          "end_sec": {"type": "number", "exclusiveMinimum": 0},
          "description": {"type": "string", "minLength": 10}
        }
      }
    },
    "static_insufficient_reason": {"type": "string", "minLength": 10},
    "shortcut_results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer_only", "single_frame", "sparse_frame", "subtitle_only", "static_caption_only"],
      "properties": {
        "answer_only": {"type": "string", "enum": ["pass", "fail", "not_run"]},
        "single_frame": {"type": "string", "enum": ["pass", "fail", "not_run"]},
        "sparse_frame": {"type": "string", "enum": ["pass", "fail", "not_run"]},
        "subtitle_only": {"type": "string", "enum": ["pass", "fail", "not_run"]},
        "static_caption_only": {"type": "string", "enum": ["pass", "fail", "not_run"]}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_full_video_correct", "human_single_frame_status", "answer_leakage_status", "subtitle_leakage_status", "decision"],
      "properties": {
        "human_full_video_correct": {"type": "boolean"},
        "human_single_frame_status": {"type": "string", "enum": ["wrong", "uncertain", "correct", "not_run"]},
        "answer_leakage_status": {"type": "string", "enum": ["pass", "fail", "not_run"]},
        "subtitle_leakage_status": {"type": "string", "enum": ["pass", "fail", "not_run"]},
        "decision": {"type": "string", "enum": ["accept", "revise", "reject"]}
      }
    }
  }
}

